# ClassroomGuard configuration - copy to .env and fill in the required values.
# Generate secrets with:  openssl rand -hex 32

# ── Required ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
# Signs login tokens. 32+ random characters; the API refuses to start in production without it.
JWT_SECRET=change-me-to-64-hex-characters
# Shared secret the AI engine uses to send detections to the API.
AI_SERVICE_TOKEN=change-me-to-64-hex-characters

# ── Web ─────────────────────────────────────────────────────────────────────
APP_ENV=production
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
# JSON list of browser origins allowed to call the API
ALLOWED_ORIGINS=["http://localhost:3000"]
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database (local container defaults; on AWS set DATABASE_URL to RDS instead) ──
POSTGRES_USER=classroomguard
POSTGRES_DB=classroomguard
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/classroomguard
# REDIS_URL=redis://host:6379/0

# ── Images (AWS / registry deploys) ─────────────────────────────────────────
# IMAGE_PREFIX=<account>.dkr.ecr.<region>.amazonaws.com/classroomguard
# IMAGE_TAG=latest
# AWS_REGION=ap-south-1

# ── Monitoring profile (localhost only) ─────────────────────────────────────
# GRAFANA_ADMIN_PASSWORD=change-me
