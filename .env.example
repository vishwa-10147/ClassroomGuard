# ClassroomGuard configuration. Copy to .env (or let scripts/install.sh create it) and keep it
# private: chmod 600 .env. Generate secrets with:  openssl rand -hex 32

# ── Required ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me-to-a-long-random-password
# Signs login tokens. 32+ random characters; the API refuses to start in production otherwise.
JWT_SECRET=change-me-to-64-hex-characters
# Shared secret the AI engine uses to send detections to the API (same value on every AI host).
AI_SERVICE_TOKEN=change-me-to-64-hex-characters

# ── Which compose files and profiles `docker compose` uses ────────────────────
# On-premise with HTTPS (COMPOSE_PATH_SEPARATOR makes ":" work on Linux and Windows):
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# Add the GPU AI engine on this machine:
# COMPOSE_PROFILES=ai

# ── Web address ───────────────────────────────────────────────────────────────
APP_ENV=production
# Name or IP users open; used by the HTTPS overlay
SITE_ADDRESS=classroomguard.college.edu
# internal (self-signed CA) | /certs/fullchain.pem /certs/privkey.pem (college cert) | email (Let's Encrypt)
CADDY_TLS=internal
# Public URL of the web app (used in password-reset emails)
FRONTEND_URL=https://classroomguard.college.edu
# JSON list of browser origins allowed to call the API
ALLOWED_ORIGINS=["https://classroomguard.college.edu"]
# Host port for the web app when NOT using the HTTPS overlay
FRONTEND_PORT=3000
ACCESS_TOKEN_EXPIRE_MINUTES=60
TZ=Asia/Kolkata

# ── Email (password-reset links). Leave SMTP_HOST empty to disable. ──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ClassroomGuard <no-reply@college.edu>
SMTP_STARTTLS=true
SMTP_SSL=false

# ── Database (bundled container). For an external server set DATABASE_URL. ─────
POSTGRES_USER=classroomguard
POSTGRES_DB=classroomguard
# DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/classroomguard
# REDIS_URL=rediss://:password@redis-host:6380/0

# ── AWS / registry deploys only (docs/DEPLOY_AWS.md) ──────────────────────────
# IMAGE_PREFIX=<account>.dkr.ecr.<region>.amazonaws.com/classroomguard
# IMAGE_TAG=latest
# AWS_REGION=ap-south-1

# ── Monitoring profile (localhost only) ───────────────────────────────────────
# Grafana refuses to start without it (COMPOSE_PROFILES=monitoring)
GRAFANA_ADMIN_PASSWORD=change-me
